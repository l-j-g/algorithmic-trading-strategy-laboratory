{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithmic-trading-strategy-laboratory/schemas/jesse-execution-result/v1",
  "type": "object",
  "required": ["schema_version", "transport", "request_id", "experiment_id", "work_item_id", "status", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "transport": {"const": "jesse_mcp"},
    "request_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "running", "finished", "stopped", "terminated", "unknown"]},
    "session_id": {"type": ["string", "null"]},
    "dashboard_url": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message", "retryable", "details"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "details": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
