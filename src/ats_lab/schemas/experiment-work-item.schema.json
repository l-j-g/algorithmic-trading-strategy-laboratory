{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ats-lab://workflow-v2/experiment-work-item/v1",
  "type": "object",
  "required": ["schema_version", "experiment", "work_item"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment": {
      "type": "object",
      "required": ["id", "strategy_name", "experiment_type", "hypothesis", "routes", "success_gates", "failure_gates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "strategy_name": {"type": "string", "minLength": 1},
        "experiment_type": {"enum": ["baseline", "multi_window", "cost_sensitivity", "out_of_sample", "significance", "monte_carlo", "hpo", "harness_check", "unknown"]},
        "hypothesis": {"type": "string"},
        "archetype": {"type": "string"},
        "target_regime": {"type": "string"},
        "failure_regime": {"type": "string"},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
        "data_routes": {"type": "array", "items": {"$ref": "#/$defs/data_route"}},
        "success_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
        "failure_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}
      },
      "additionalProperties": true
    },
    "work_item": {
      "type": "object",
      "required": ["id", "experiment_id", "state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "experiment_id": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "state": {"enum": ["scheduled", "ready", "blocked"]},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["exchange", "symbol", "timeframe", "start_date", "finish_date"],
      "properties": {
        "exchange": {"type": "string"}, "symbol": {"type": "string"}, "timeframe": {"type": "string"},
        "start_date": {"type": "string"}, "finish_date": {"type": "string"}
      },
      "additionalProperties": false
    },
    "data_route": {
      "type": "object",
      "required": ["exchange", "symbol", "timeframe"],
      "properties": {
        "exchange": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "timeframe": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["name", "operator"],
      "properties": {"name": {"type": "string"}, "operator": {"type": "string"}, "threshold": {}, "required": {"type": "boolean"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
